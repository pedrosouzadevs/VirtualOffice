{
    "name": "admin-api",
    "version": "1.0.0",
    "description": "VirtualOffice Admin API: members, tags and permissions (implements the contract the pusher expects)",
    "type": "module",
    "main": "index.js",
    "private": true,
    "scripts": {
        "start": "ESBK_TSCONFIG_PATH=tsconfig.json tsx ./src/index.ts",
        "start:dev": "ESBK_TSCONFIG_PATH=tsconfig.json tsx watch --clear-screen=false --inspect=0.0.0.0:9229 ./src/index.ts",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint-fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "pretty": "prettier --write \"{src,tests}/**/*.ts\"",
        "pretty-check": "prettier --check \"{src,tests}/**/*.ts\"",
        "precommit": "lint-staged",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:cov": "vitest --coverage"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@workadventure/messages": "1.0.0",
        "express": "^5.2.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.1",
        "@workadventure/eslint-config": "1.0.0",
        "eslint": "^9.39.4",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "vitest": "^4.1.7"
    }
}
